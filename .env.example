# Public canonical origin. Use an HTTPS URL in production.
NEXT_PUBLIC_SITE_URL=

# Required for production submissions and accounts. Store on a private persistent volume.
SCRIPTMOTH_DB_PATH=

# Account and signed download settings. Generate a unique random secret of 32+ characters.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
SCRIPTMOTH_ADMIN_EMAILS=

# Transactional email. Use a verified sender and an operator inbox.
RESEND_API_KEY=
SCRIPTMOTH_MAIL_FROM=
SCRIPTMOTH_INQUIRY_EMAIL=

# Set only if your trusted proxy overwrites this header with the authenticated client IP.
SCRIPTMOTH_TRUSTED_IP_HEADER=

# Optional. Start with test-mode credentials and a matching webhook secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
