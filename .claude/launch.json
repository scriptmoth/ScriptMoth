{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-qa",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3007"
      ],
      "port": 3007,
      "env": {
        "NEXT_DIST_DIR": ".next-qa"
      }
    },
    {
      "name": "dev-verify",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3011"
      ],
      "port": 3011,
      "env": {
        "NEXT_DIST_DIR": ".next-verify"
      }
    }
  ]
}
